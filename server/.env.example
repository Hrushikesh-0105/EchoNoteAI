# Server port. Defaults to 4000 if unset.
PORT=3000

# MongoDB Atlas connection string. Atlas dashboard -> your cluster -> Connect ->
# Drivers -> copy the string, then replace <db_password> with your Database Access
# user's password (not your Atlas account password).
MONGODB_URI="mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/<database>"

# OCR.space API key. Free key emailed instantly at https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY=your-ocr-space-api-key

# OCR.space endpoint. Optional — defaults to https://api.ocr.space/parse/image
OCR_SPACE_API_URL=https://api.ocr.space/parse/image

# Gemini API key. Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Gemini model to use for summarization. Optional — defaults to gemini-3.6-flash.
# Change here (not in code) when Google deprecates a model.
GEMINI_MODEL=gemini-3.6-flash

# Clerk secret key (NOT the publishable key). Clerk dashboard -> your app -> API Keys
# -> Secret key. Must be the same Clerk application as the client's
# VITE_CLERK_PUBLISHABLE_KEY, or token verification will always fail.
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key

# Signs the short-lived tokens minted for the browser extension (see
# services/extensionTokenService.js). Generate a random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Do not share or reuse this value across environments.
EXTENSION_TOKEN_SECRET=generate-a-random-secret-value

# How long a minted extension token stays valid. Optional — defaults to 7d.
EXTENSION_TOKEN_TTL=7d

# RabbitMQ login. Docker Compose reads these (via --env-file server/.env) to create the
# broker's user and to build RABBITMQ_URL for the api and worker containers. Don't set
# RABBITMQ_URL yourself. Change both for any shared or production deployment.
RABBITMQ_USER=admin
RABBITMQ_PASS=password

# Worker tuning. Optional — defaults shown.
# OCR jobs each worker handles at once (raise carefully: every job is an OCR.space call)
OCR_PREFETCH=2
# Attempts before a screenshot is marked failed / a summary is marked failed (retries wait 10s / 30s)
OCR_MAX_ATTEMPTS=3
SUMMARY_MAX_ATTEMPTS=2

# Comma-separated list of origins allowed to call this API (the website's origin).
# The browser extension doesn't need to be listed here — it bypasses CORS via its
# own host_permissions in web_extension/manifest.json instead.
CORS_ALLOWED_ORIGINS=http://localhost:5173
