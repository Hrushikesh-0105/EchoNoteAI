# EchoNoteAI configuration: one file for the whole app.
# Copy to .env (same folder) and fill in the values:   cp .env.example .env
# Docker Compose reads it for the api, worker, client and rabbitmq containers.
# After editing, restart with `npm run dev` (a plain container restart doesn't reload it).

# ─── Required ─────────────────────────────────────────────────────────────────

# MongoDB connection string (e.g. MongoDB Atlas: your cluster -> Connect -> Drivers).
# Replace <db_password> with the database user's password, not your Atlas login.
MONGODB_URI="mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/<database>"

# Clerk (sign-in). Clerk dashboard -> your app -> API Keys. Both keys must come from the
# same Clerk application, or token verification will always fail.
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key

# Signs the tokens handed to the browser extension. Generate a random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
EXTENSION_TOKEN_SECRET=generate-a-random-secret-value

# Gemini (summaries). Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# OCR.space (text from screenshots). Free key: https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY=your-ocr-space-api-key

# Cloudinary (screenshot storage). Console -> Settings -> API Keys.
# The key needs upload ("create") permission, or uploads fail with 403.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# The browser extension's ID, so the website can hand it a sign-in token. Load the
# unpacked web_extension/ folder at chrome://extensions and copy the ID from its card.
VITE_EXTENSION_ID=your-extension-id

# ─── Optional (defaults shown) ────────────────────────────────────────────────

# RabbitMQ login, used to create the broker's user and to connect the api and worker.
# Change both for any shared or production deployment.
RABBITMQ_USER=admin
RABBITMQ_PASS=password

# Where the website reaches the API (no trailing slash), and which website origins the
# API accepts (comma-separated). The extension doesn't need to be listed.
VITE_API_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# How long an extension token stays valid
EXTENSION_TOKEN_TTL=7d

# Gemini model for summaries; change it here when Google retires a model
GEMINI_MODEL=gemini-3.6-flash

# OCR.space endpoint
OCR_SPACE_API_URL=https://api.ocr.space/parse/image

# Top-level Cloudinary folder; screenshots go to <folder>/<userId>/<sessionId>/
CLOUDINARY_COLLECTION_NAME=echonote

# Session limits (milliseconds unless noted)
# No screenshot for this long while recording -> the session closes when its summary is requested
STALE_SESSION_MS=60000
# Longest a recording may run (1 hour); the extension stops itself at this point
MAX_SESSION_DURATION_MS=3600000
# Screenshot cap per session (count), a backstop for the time limit
MAX_IMAGES_PER_SESSION=760
# A screenshot still waiting for OCR after this long is marked failed
IMAGE_STUCK_MS=300000
# A summary still generating after this long may be started again
SUMMARY_STUCK_MS=600000
# Most characters of OCR text sent to Gemini for one summary
SUMMARY_MAX_INPUT_CHARS=1200000

# Worker tuning
# OCR jobs each worker runs at once (each one is an OCR.space call)
OCR_PREFETCH=2
# Attempts before a screenshot / a summary is marked failed (retries wait 10s / 30s)
OCR_MAX_ATTEMPTS=3
SUMMARY_MAX_ATTEMPTS=2
