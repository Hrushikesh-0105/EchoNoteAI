# Clerk publishable key. Clerk dashboard -> your app -> API Keys -> Publishable key.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key

# Base URL of the server (server/.env's PORT). No trailing slash.
VITE_API_BASE_URL=http://localhost:3000

# The browser extension's ID, so the website knows who to chrome.runtime.sendMessage
# the auth token to (see src/components/SendTokenToExtension.jsx). Load the unpacked
# web_extension/ folder at chrome://extensions with Developer Mode on, then copy the
# ID shown on its card. Changes between a dev (unpacked) and published build.
VITE_EXTENSION_ID=your-extension-id
